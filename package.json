{
  "name": "medusa-plugin-elasticsearch",
  "packageManager": "yarn@3.2.4",
  "version": "1.1.1",
  "description": "Elasticsearch search plugin for Medusa v2",
  "author": "Peter Borodatyy <peterborodatyy@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/peterborodatyy/medusa-plugin-elasticsearch"
  },
  "bugs": {
    "url": "https://github.com/peterborodatyy/medusa-plugin-elasticsearch/issues"
  },
  "homepage": "https://github.com/peterborodatyy/medusa-plugin-elasticsearch",
  "license": "MIT",
  "keywords": [
    "medusa-plugin-integration",
    "medusa-plugin-search",
    "medusa-v2",
    "elasticsearch"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./workflows": "./.medusa/server/src/workflows/index.js",
    "./.medusa/server/src/modules/*": "./.medusa/server/src/modules/*/index.js",
    "./admin": {
      "import": "./.medusa/server/src/admin/index.mjs",
      "require": "./.medusa/server/src/admin/index.js",
      "default": "./.medusa/server/src/admin/index.js"
    },
    "./*": "./.medusa/server/src/*.js"
  },
  "files": [
    ".medusa",
    "!.medusa/server/src/**/__tests__"
  ],
  "scripts": {
    "build": "medusa plugin:build",
    "lint": "eslint src/",
    "format": "prettier --write \"src/**/*.ts\" \"*.{json,mjs}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"*.{json,mjs}\"",
    "test": "jest",
    "test:integration": "jest --testPathPattern=__tests__ --forceExit"
  },
  "resolutions": {
    "@babel/core": "^7.29.6",
    "@babel/helpers": "^7.26.10",
    "@babel/traverse": "^7.23.2",
    "@protobufjs/utf8": "^1.1.2",
    "axios": "^1.19.0",
    "body-parser": "^1.20.6",
    "brace-expansion@^1.1.7": "^1.1.18",
    "braces": "^3.0.3",
    "cross-spawn": "^7.0.6",
    "fast-uri": "^3.1.5",
    "fast-xml-builder": "^1.1.7",
    "fast-xml-parser": "^5.7.0",
    "follow-redirects": "^1.16.0",
    "form-data": "^4.0.6",
    "handlebars": "^4.7.9",
    "immutable": "^5.1.9",
    "ip-address": "^10.3.1",
    "js-yaml@^3.13.1": "^3.15.1",
    "minimatch@^3.0.4": "^3.1.4",
    "minimatch@^3.1.1": "^3.1.4",
    "nanoid": "^3.3.18",
    "path-to-regexp@~0.1.12": "^0.1.13",
    "picomatch@^4.0.3": "^4.0.5",
    "postcss": "^8.5.26",
    "protobufjs": "^7.6.5",
    "qs": "^6.15.3",
    "react-router": "^7.18.0",
    "react-router-dom": "^7.18.2",
    "tar": "^7.5.22",
    "undici": "^7.29.0",
    "uuid@^9.0.0": "^11.1.1",
    "vite": "^6.4.3"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^9.5.0"
  },
  "peerDependencies": {
    "@medusajs/admin-sdk": "^2.5.0",
    "@medusajs/cli": "^2.5.0",
    "@medusajs/framework": "^2.5.0",
    "@medusajs/medusa": "^2.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@medusajs/admin-sdk": "^2.18.0",
    "@medusajs/cli": "^2.18.0",
    "@medusajs/framework": "^2.18.0",
    "@medusajs/js-sdk": "^2.18.0",
    "@medusajs/medusa": "^2.18.0",
    "@medusajs/test-utils": "^2.18.0",
    "@swc/core": "^1.5.7",
    "@types/jest": "^29.5.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.0",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/node_modules/"
    ],
    "moduleNameMapper": {
      "^(\\.\\.?/.*)\\.js$": "$1"
    },
    "rootDir": "src",
    "testRegex": "(/__tests__/.*|\\.(test|spec))\\.(ts|js)$",
    "transform": {
      ".ts": [
        "ts-jest",
        {
          "tsconfig": {
            "module": "commonjs",
            "moduleResolution": "node"
          }
        }
      ]
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node"
  }
}
